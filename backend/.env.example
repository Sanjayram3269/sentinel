APP_NAME="SENTINEL Backend"
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev_password@localhost:15432/sentinel
REDIS_URL=redis://localhost:6379/0

# Browser origins allowed to call this API. An explicit allowlist is
# required; there is no wildcard option. Defaults to the local Vite dev
# server on http://localhost:5173 when unset. JSON list format.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Road network reference data. The key selects which imported network routing
# and resilience use. No network is created at startup; an absent network
# leaves the existing development behaviour untouched. Defaults to
# osm_urban_v1, which is created by the operator-run importer, never by
# application startup or by an Alembic migration.
# ROAD_NETWORK_KEY=osm_urban_v1

# Importing OSM data is an explicit operator action and is never performed by
# application startup or by an Alembic migration.
# ROAD_NETWORK_IMPORT_ENABLED=false

# Optional SUMO digital twin. Leave unset to run only the synthetic development
# fixture. SUMO_CONFIG_PATH stays server-local and is never accepted from a
# request body or returned in an API response.
SUMO_BINARY=sumo
# SUMO_CONFIG_PATH=/absolute/path/to/scenario.sumocfg
# SUMO_NETWORK_ID=team-network-v1

# The verified demo network ships in this repository. Verified with SUMO 1.27.1.
# Its signal metadata (including the green pre-emption phase) is committed at
# simulation/scenarios/clearpath_demo/signals.json.
# SUMO_CONFIG_PATH=./simulation/scenarios/clearpath_demo/demo.sumocfg
# SUMO_NETWORK_ID=clearpath-demo-v1
