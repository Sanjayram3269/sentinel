APP_NAME="SENTINEL Backend"
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev_password@localhost:15432/sentinel
REDIS_URL=redis://localhost:6379/0

# Browser origins allowed to call this API. An explicit allowlist is
# required; there is no wildcard option. Defaults to the local Vite dev
# server on http://localhost:5173 when unset. JSON list format.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Road network reference data. The key selects which imported network routing
# and resilience use. No network is created at startup; an absent network
# leaves the existing development behaviour untouched. Defaults to
# osm_urban_v1, which is created by the operator-run importer, never by
# application startup or by an Alembic migration.
# ROAD_NETWORK_KEY=osm_urban_v1

# Importing OSM data is an explicit operator action and is never performed by
# application startup or by an Alembic migration.
# ROAD_NETWORK_IMPORT_ENABLED=false

# AI intelligence layer. Disabled by default. When enabled, ETA and
# ROUTE_FAILURE predictions are computed from the imported road graph above;
# CONGESTION and HAZARD_IMPACT have no AI implementation and always use the
# deterministic predictors. With the layer disabled every prediction type
# uses the deterministic predictors exactly as before.
# SENTINEL_AI_ENABLED=false

# Absolute path to the directory holding the trained artifact
# (sentinel_models.pkl). A relative path is refused at load time. No trained
# artifact is committed, so leaving this unset means AI predictions report
# source=baseline_fallback; that is the state of this repository.
# AI_MODEL_PATH=/absolute/path/to/artifact/directory

# Reported alongside AI predictions so a stored record can be traced to the
# artifact version that produced it.
# AI_MODEL_VERSION=none

# Optional SUMO digital twin. Leave unset to run only the synthetic development
# fixture. SUMO_CONFIG_PATH stays server-local and is never accepted from a
# request body or returned in an API response.
SUMO_BINARY=sumo
# SUMO_CONFIG_PATH=/absolute/path/to/scenario.sumocfg
# SUMO_NETWORK_ID=team-network-v1

# The verified demo network ships in this repository. Verified with SUMO 1.27.1.
# Its signal metadata (including the green pre-emption phase) is committed at
# simulation/scenarios/clearpath_demo/signals.json.
# SUMO_CONFIG_PATH=./simulation/scenarios/clearpath_demo/demo.sumocfg
# SUMO_NETWORK_ID=clearpath-demo-v1

# Real road-graph route generation. When a route-candidate request supplies no
# geometry, routes are generated by searching the imported network above
# instead of trusting caller-supplied polylines. A coordinate further than
# ROUTE_MAX_SNAP_METERS from the nearest road node is refused rather than
# snapped, and an origin/destination pair with no directed path is refused
# too -- routing never invents a road.
# ROUTE_MAX_SNAP_METERS=250.0

# Upper bound on generated candidates, including the shortest path.
# ROUTE_MAX_CANDIDATES=4

# Cost multiplier applied to already-used edges when generating an
# alternative, so alternatives leave the primary route's streets. Values
# above 1 push alternatives further away from the primary; 1.0 would
# reproduce the primary.
# ROUTE_ALTERNATIVE_PENALTY=2.0

# MINIMIZE_TRAVEL_TIME uses the stored length_m / speed_limit_kmh of each
# edge; MINIMIZE_DISTANCE uses the stored length_m only.
# ROUTE_OBJECTIVE=MINIMIZE_TRAVEL_TIME

# --- Mission optimization (Phase 6) -------------------------------------
# The optimizer only selects among route candidates that already exist; these
# settings bound that search and weight it. They never trigger route generation.

# A route candidate whose stored destination lies within this radius of a
# hospital point is treated as a route *to that hospital*. It mirrors
# ROUTE_MAX_SNAP_METERS because a hospital address is the same kind of
# reference point as a trip endpoint.
# OPTIMIZATION_HOSPITAL_MATCH_METERS=250.0

# Upper bounds on hospitals considered and route candidates kept per hospital,
# so the joint hospital x route search cannot grow without limit. Hospitals
# beyond the bound are dropped least-capable first and the plan says so.
# OPTIMIZATION_MAX_HOSPITALS=8
# OPTIMIZATION_MAX_ROUTE_CANDIDATES=8

# Soft objective weights. These are costs, normalised into [0,1] where 1 is
# worst; the lowest weighted total wins. The weights must not all be zero.
# Capacity and reliability are absolute (free-capacity share, and the hospital's
# recorded reliability), so a hospital is judged on its own merits rather than
# only against the other candidates. ETA has no defensible absolute target for
# an emergency, so it is scored relative to the alternatives.
# OPTIMIZATION_WEIGHT_ETA=0.30
# OPTIMIZATION_WEIGHT_ROUTE_RISK=0.20
# OPTIMIZATION_WEIGHT_CAPABILITY=0.20
# OPTIMIZATION_WEIGHT_CAPACITY=0.10
# OPTIMIZATION_WEIGHT_RELIABILITY=0.10
# OPTIMIZATION_WEIGHT_RESOURCE_PROXIMITY=0.10
